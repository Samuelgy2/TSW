# dependencias
/node_modules
/.pnp
.pnp.*

# build
# Cualquier carpeta de salida de Next: `.next` y las de NEXT_DIST_DIR
# (.next-verificar, .next-verificar-dev, .next-seo, .next-prueba-*…).
/.next/
/.next-*/
/out/
/build
next-env.d.ts.timestamp
# Lo regenera Next en cada build y su contenido depende de la carpeta de salida
# que se usó la última vez: rastrearlo era ruido en cada diff.
next-env.d.ts
*.tsbuildinfo

# entorno
.env
.env.local
.env.local.*
.env.*.local

# supabase
/supabase/.branches
/supabase/.temp

# sistema
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-error.log*

# scripts de un solo uso: nunca -c/-e/heredocs sueltos, siempre a un archivo aquí
/scripts/tmp/*
!/scripts/tmp/.gitkeep

# vercel
.vercel
tsconfig.tsbuildinfo
